; Golden tests for the bm-export plugin. Each fixture is exported with the
; plugin built in this project, and the result is compared with a JSON file
; written by hand. The fixtures use no standard library, so they do not need
; `clerk start`.

(executable
 (name check)
 (modules check)
 (libraries yojson))

(rule
 (deps ../plugin/bm_export.cmxs)
 (action
  (with-stdout-to
   lit_money.out.json
   (run catala bm-export --plugin-dir ../plugin --no-stdlib -s LitMoney %{dep:lit_money.catala_en}))))

(rule
 (alias runtest)
 (action
  (run %{exe:check.exe} json %{dep:lit_money.expected.json} %{dep:lit_money.out.json})))

