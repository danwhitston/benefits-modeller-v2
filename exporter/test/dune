; A list literal is outside bm-ir: the export must fail and name the
; construct and its line.

(rule
 (deps ../plugin/bm_export.cmxs)
 (action
  (with-accepted-exit-codes
   (not 0)
   (with-outputs-to
    unsupported.out.txt
    (run catala bm-export --plugin-dir ../plugin --no-stdlib --color=never -s Unsupported %{dep:unsupported.catala_en})))))

(rule
 (alias runtest)
 (action
  (run %{exe:check.exe} contains %{dep:unsupported.expected.txt} %{dep:unsupported.out.txt})))

; An input that is also an output has no definition, so it cannot be listed in
; outputs: the export must fail.

(rule
 (deps ../plugin/bm_export.cmxs)
 (action
  (with-accepted-exit-codes
   (not 0)
   (with-outputs-to
    input_output.out.txt
    (run catala bm-export --plugin-dir ../plugin --no-stdlib --color=never -s InputOutput %{dep:input_output.catala_en})))))

(rule
 (alias runtest)
 (action
  (run %{exe:check.exe} contains %{dep:input_output.expected.txt} %{dep:input_output.out.txt})))

; Only a sub-scope declared in the scope is inlined. A direct call to a scope
; inside an expression stays unsupported: the export must fail.

(rule
 (deps ../plugin/bm_export.cmxs)
 (action
  (with-accepted-exit-codes
   (not 0)
   (with-outputs-to
    subscope_direct.out.txt
    (run catala bm-export --plugin-dir ../plugin --no-stdlib --color=never -s Direct %{dep:subscope_direct.catala_en})))))

(rule
 (alias runtest)
 (action
  (run %{exe:check.exe} contains %{dep:subscope_direct.expected.txt} %{dep:subscope_direct.out.txt})))
