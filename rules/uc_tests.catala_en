      -- aged_25_or_over: true
      -- has_lcw: true
      -- housing_costs_element: $500.00
    }
  assertion (computation.work_allowance = $427.00)
  assertion (computation.earnings_deduction = $0.00)
  assertion (computation.maximum_amount = $924.90)
  assertion (computation.award = $924.90)
```

